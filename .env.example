# Legacy customer WebService credentials (issued by SFC).
# Template only: copy these NAME=VALUE lines into a private file outside the
# repository (default ~/.config/sfc/credentials.env, or the path in SFC_ENV_FILE)
# or into the gitignored .env, and never commit real values.
SFC_APP_KEY=
SFC_TOKEN=
SFC_USER_ID=
# Optional: set the division confirmed by SFC. Leave empty and the Step 2
# discovery flow probes divisionId=1 then 17 and records the first that works.
SFC_DIVISION_ID=
